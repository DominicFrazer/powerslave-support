# macOS Finder droppings. .DS_Store appears in any directory browsed in Finder,
# and ._* AppleDouble files appear when the tree is copied to a non-Mac volume
# or unzipped from an archive.
.DS_Store
._*

# Python bytecode from tools/. Running build-articles.py directly doesn't
# produce any, but it will the moment anything in tools/ gets imported.
__pycache__/
*.py[cod]

# Claude Code's per-machine tool permissions. Only the local overrides are ignored:
# .claude/settings.json is the shareable half and should be committed if one ever
# exists, which is why this isn't a blanket .claude/ rule.
.claude/settings.local.json
